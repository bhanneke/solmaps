.DS_Store
# generated pages and precomputed data (rebuild with the scripts)
atlas/solar-system-atlas.html
network/solar-system-growth-map.html
network/network.json
network/stations.json
network/stations.log
.claude/
flyby/*.log
__pycache__/
surrogate/*.npz
surrogate/*.pt
atlas3d/solar-system-3d.html
stations/costs.npz
stations/precompute.log
stations/pairs.json
data/
.pytest_cache/
flyby/horizons/*.json

# credentials never go into git (tokens live in the home folder: ~/.cache/huggingface/token, ~/.zenodo_token)
.env
.env.*
*.env
*.pem
*.key
secrets/
.huggingface/
.zenodo_token
token
*.token
*_token
network/network_*.json

# contributor runs: receipts and fetched inputs stay local until submitted
contrib/out*/
contrib/inputs/
*.before-verify

# every option per route (engine.daily options); the site build copies them to docs/options
network/options/

# compiled screening kernel (make fortran)
engine/fortran/screen_unit
engine/fortran/*.mod
