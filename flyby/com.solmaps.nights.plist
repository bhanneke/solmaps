<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- solmaps: laptop help for the compute host's flyby search. Calls the controller every 2 minutes and at login; the
     controller decides by itself (all in when nobody uses the laptop, 2 cores in use, paused on battery or away). Install: copy to
     ~/Library/LaunchAgents and `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.solmaps.nights.plist`.
     Remove: launchctl bootout gui/$(id -u)/com.solmaps.nights && rm ~/Library/LaunchAgents/com.solmaps.nights.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.solmaps.nights</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/hanneke/Library/Application Support/solmaps-nights/flyby/run_macbook_nights.sh</string>
  </array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <!-- keep the caffeinate the controller leaves behind (no idle sleep until the next call) -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>/Users/hanneke/Library/Application Support/solmaps-nights/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/hanneke/Library/Application Support/solmaps-nights/launchd.log</string>
</dict>
</plist>
